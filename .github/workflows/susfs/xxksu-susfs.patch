--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -78,12 +78,14 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 	uid_t new_uid = ksu_get_uid_t(new->uid);
 	uid_t old_uid = ksu_get_uid_t(old->uid);
 
+#ifndef CONFIG_KSU_SUSFS
 	if (!ksu_kernel_umount_enabled)
 		return 0;
 
 	// if there isn't any module mounted, just ignore it!
 	if (!ksu_module_mounted)
 		return 0;
+#endif
 
 	// There are 6 scenarios:
 	// 1. Normal app: zygote -> appuid
@@ -110,6 +112,10 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 	// umount the target mnt
 	pr_info("handle umount for uid: %d, pid: %d\n", new_uid, current->pid);
 
+#ifdef CONFIG_KSU_SUSFS
+	// susfs: a qualifying process is marked below even if there is nothing to umount
+	if (ksu_kernel_umount_enabled && ksu_module_mounted) {
+#endif
 	// hostsredirect and getpriority filter tracks this flag
 	set_thread_flag(TIF_KSU_UNMOUNTABLE);
 
@@ -125,6 +131,14 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 
 	revert_creds(saved);
 
+#ifdef CONFIG_KSU_SUSFS
+	}
+
+	if (!work_pending(&susfs_extra_works))
+		schedule_work(&susfs_extra_works);
+	susfs_set_current_proc_umounted();
+#endif
+
 	return 0;
 }
 
